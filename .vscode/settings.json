{
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "/usr/local/texlive/2025basic/bin/universal-darwin/latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {
                "PATH": "/usr/local/texlive/2025basic/bin/universal-darwin:/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${env:PATH}",
                "PERL5LIB": "",
                "TEXMFHOME": "",
                "TEXMFVAR": "",
                "TEXMFCACHE": ""
            }
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk 🔃",
            "tools": [
                "latexmk"
            ]
        }
    ],
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.idx",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.ist",
        "*.fls",
        "*.log",
        "*.fdb_latexmk",
        "*.synctex.gz",
        "*.bcf",
        "*.run.xml",
        "*.nlo",
        "*.nls"
    ]
}

